{
  "name": "@gct/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch-path=./src src/server.ts",
    "start": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset",
    "db:seed": "prisma db seed",
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio",
    "postinstall": "prisma generate",
    "demo": "node --env-file-if-exists=.env --import tsx scripts/demo.ts",
    "setup": "node --import tsx scripts/setup.ts",
    "reset:data": "node --env-file-if-exists=.env --import tsx scripts/reset-data.ts"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/jwt": "10.2.2",
    "@fastify/sensible": "6.0.5",
    "@fastify/static": "10.1.3",
    "@gct/shared": "*",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "0.45.1",
    "fastify": "5.12.1",
    "fastify-plugin": "6.0.0",
    "nodemailer": "9.0.6",
    "pdfkit": "0.20.1",
    "pg": "8.23.0",
    "qrcode": "1.5.4",
    "resend": "6.25.0",
    "tesseract.js": "7.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/nodemailer": "8.0.1",
    "@types/pdfkit": "0.17.6",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "dotenv": "17.4.2",
    "prisma": "7.10.0",
    "tsx": "4.23.12",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
