# ============ apps/api  (copy to apps/api/.env) ============
NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://gct:gct@localhost:5432/gct?schema=public&connection_limit=24"

# Shadow DB for `prisma migrate dev` diffing. Optional locally (the docker 'gct' role
# is a container superuser and migrate dev manages an ephemeral shadow DB itself).
# Set it for CI or any environment whose migration role lacks CREATEDB:
# SHADOW_DATABASE_URL="postgresql://gct:gct@localhost:5432/gct_shadow?schema=public"

# auth (auth slice, M1)
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=900          # seconds
JWT_REFRESH_TTL=2592000     # seconds (30d)

# serial allocator clock (batch slice, M2)
SERIAL_YEAR_TZ=Africa/Johannesburg

# QR payload signing (batch slice, M2)
# Scheme B / GCT2 (recommended): server signs, device verifies with the PUBLIC key only.
# Generate with: npx tsx apps/api/scripts/gen-qr-keys.ts
QR_SIGN_PRIVATE_KEY_HEX=
QR_SIGN_PUBLIC_KEY_HEX=
# Scheme A / GCT1 (only if overriding the recommendation; secret ships in the APK):
# QR_HMAC_SECRET=

# mail (pluggable Mailer, M4)
# resend   = production transport; see "Sending real email" in README.md
# ---- mail ----
# resend  = the transport that actually sends. Needs RESEND_API_KEY; the API refuses
#           to start without it, on purpose — a mail setup that silently delivers
#           nothing is the worst state this can be in.
# sendgrid = alternative, over SMTP. Needs SENDGRID_API_KEY.
# capture  = keeps messages in memory and sends nothing. The integration suite's
#           transport, not a deployment option. Set here only while you have no key.
MAILER=capture
MAIL_FROM="Gas Cylinder Tracker <no-reply@gct.local>"
# EMAIL_FROM is the same setting under the change spec's name; it wins when both are set.
# EMAIL_FROM="Batch System <noreply@yourdomain.com>"
SENDGRID_API_KEY=
# Server-only secret — NEVER an EXPO_PUBLIC_* var, which would ship inside the APK.
# ---- who Resend will actually deliver to ----
# With NO verified domain, Resend accepts exactly one sender - its shared testing
# address, onboarding@resend.dev - and delivers only to the address that owns the
# Resend account. A batch whose project manager is anyone else queues, is refused
# with a 403, and sits PENDING with the reason in OutboundEmail.lastError. The app
# records that correctly; it does not appear on screen.
#
# To email anyone: verify a domain at resend.com/domains (SPF + DKIM DNS records),
# then set MAIL_FROM to an address at that domain.

# Required when MAILER=resend; the API refuses to start without it.
RESEND_API_KEY=

# local file storage for generated PDFs / signature PNGs (M2/M4)
STORAGE_DIR=./var/storage

# Where generated PDFs, signatures, photos and driver ID documents actually live.
#   fs  (default) - under STORAGE_DIR. Right on any host with a durable disk.
#   db            - in Postgres, for hosts whose filesystem does not survive a
#                   restart. A free Render web service is one: its disk is wiped
#                   every time the instance spins down, which would leave the
#                   database referencing photographs that no longer exist.
# STORAGE_DRIVER=fs

# optional seed override
# Optional seed override. Left commented out so the seed's own default applies —
# `password`, which is what README.md and `npm run setup` both print. Set it here
# only if you also change what those say: an uncommented value silently wins over
# the documented one, and the demo logins then fail with no clue why. That is
# exactly what happened when this file shipped `SEED_PASSWORD=password ` (with a
# trailing space) while every document said something else.
# SEED_PASSWORD=password

# ============ apps/mobile  (copy to apps/mobile/.env) ============
# Only EXPO_PUBLIC_* vars are inlined into the bundle. No secrets here.
EXPO_PUBLIC_API_URL=http://localhost:3000
# Scheme B verify key (public — safe to embed):
EXPO_PUBLIC_QR_VERIFY_PUBLIC_KEY=
